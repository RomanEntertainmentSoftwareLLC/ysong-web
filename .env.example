VITE_APP_NAME=YSong Local
# Leave API bases blank in local mode. Vite proxies /api, /auth and /chat to
# the local API, which lets phones/tablets use the desktop's LAN IP seamlessly.
VITE_AUTH_API_URL=
VITE_API_BASE_URL=
VITE_LOCAL_MODE=1

# Vercel production settings (set in the production environment only, then rebuild):
# VITE_AUTH_API_URL=https://api.ysong.ai
# VITE_API_BASE_URL=https://api.ysong.ai
# VITE_LOCAL_MODE=0
# Keep the existing API origin until its replacement passes production validation.
# Database, Resend, R2, and Cloudflare credentials belong only on the auth API.

# Optional social sign-in UI wiring. Keep disabled until the auth API has the
# corresponding OAuth provider credentials/callback routes configured.
VITE_OAUTH_GOOGLE_ENABLED=0
VITE_OAUTH_FACEBOOK_ENABLED=0
VITE_OAUTH_APPLE_ENABLED=0

# SEO Intelligence uses the authenticated YSong API. Provider credentials stay server-side.

# Local-heavy Audio Lab engine (Stem Splitter / Stem Restore). Keep on loopback.
VITE_VOCAL_API_URL=http://127.0.0.1:8000

# AI Music Detector runs locally and is proxied by Vite by default.
# Override only when the detector service is hosted elsewhere.
VITE_AI_DETECTOR_URL=
